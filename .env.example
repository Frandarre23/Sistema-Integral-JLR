# ==============================================================================
# JLR SISTEMA INTEGRAL - VARIABLES DE ENTORNO DE EJEMPLO
# Copiar este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local
#
# IMPORTANTE:
# - Las variables con prefijo NEXT_PUBLIC_ se exponen en el navegador.
# - NUNCA expongas SUPABASE_SERVICE_ROLE_KEY ni contraseñas en el frontend.
# ==============================================================================

# Supabase API (Obtener en Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu-anon-key-aqui

# URL del sitio para callbacks de autenticación y redirecciones
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# SUPABASE_SERVICE_ROLE_KEY (Opcional - solo para tareas administrativas del servidor, nunca en cliente)
# SUPABASE_SERVICE_ROLE_KEY=

